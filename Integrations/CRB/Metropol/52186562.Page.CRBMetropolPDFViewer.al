page 52186562 "CRB Metropol PDF Viewer"
{
    ApplicationArea = All;
    Caption = 'CRB Metropol PDF Viewer';
    AboutTitle = 'CRB Metropol PDF Viewer';
    PageType = Card;
    SourceTable = Loans;

    InsertAllowed = false;
    ModifyAllowed = false;
    DeleteAllowed = false;

    layout
    {
        area(content)
        {
            field("Member Name"; Rec."Member Name")
            {
                ApplicationArea = All;
                Caption = 'Member Name';
                Editable = False;
                // ExtendedDatatype = URL;
            }
            group(General)
            {
                ShowCaption = False;
                usercontrol(PDFViewer; "PDFV2 PDF Viewer - Metropol")
                {
                    ApplicationArea = All;
                    trigger ControlAddinReady()
                    begin
                        CurrPage.PDFViewer.LoadPDF(FileData, false);
                    end;
                }
            }
        }
    }

    trigger OnOpenPage()
    begin
        if not confirm('Are you sure you want to get the credit score report of the loan applicant from Metropol?') then begin
            Error('Operation cancelled successfully');
            CurrPage.Close();
        end;
    end;

    trigger OnAfterGetCurrRecord()
    var
        theMember: Record Members;

        report_type: Enum "CRB Metropol Report Types";
        identity_number: Text;
        loan_amount: Integer;
        identity_type: Enum "CRB Metropol Identity Types";
        report_reason: Enum "CRB Metropol Report Reasons";
    begin
        theMember.Get(Rec."Member No.");

        report_type := "CRB Metropol Report Types"::"PDF Credit Report";
        loan_amount := Rec."Requested Amount";
        report_reason := "CRB Metropol Report Reasons"::"New credit application";

        case theMember."Primary Identification Type" of
            theMember."Primary Identification Type"::"ID Number":
                begin
                    identity_type := "CRB Metropol Identity Types"::"National ID";
                    identity_number := theMember."Primary Identification";
                end;
            theMember."Primary Identification Type"::"Passport No":
                begin
                    identity_type := "CRB Metropol Identity Types"::Passport;
                    identity_number := theMember."Primary Identification";
                end;
            theMember."Primary Identification Type"::"Service Number":
                begin
                    identity_type := "CRB Metropol Identity Types"::"Service ID";
                    identity_number := theMember."Primary Identification";
                end;
            else begin
                case theMember."Secondary Identification Type" of
                    theMember."Secondary Identification Type"::"ID Number":
                        begin
                            identity_type := "CRB Metropol Identity Types"::"National ID";
                            identity_number := theMember."Secondary Identification";
                        end;
                    theMember."Secondary Identification Type"::"Passport No":
                        begin
                            identity_type := "CRB Metropol Identity Types"::Passport;
                            identity_number := theMember."Secondary Identification";
                        end;
                    theMember."Secondary Identification Type"::"Service Number":
                        begin
                            identity_type := "CRB Metropol Identity Types"::"Service ID";
                            identity_number := theMember."Secondary Identification";
                        end;
                    else begin
                        Error('Missing required primary and secondary identification of the loan applicant/member.');
                    end;
                end;
            end;
        end;

        FileData := CRBMetropol.ReportType4(true, report_type, identity_number, loan_amount, identity_type, report_reason);

        if FileData = '' then begin
            CurrPage.Close();
        end;

        // FileData := '';
    end;

    var
        FileData: Text;
        CRBMetropol: Codeunit "CRB Metropol API";
}
