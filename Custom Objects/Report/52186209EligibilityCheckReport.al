                trigger OnAfterGetRecord()
                var
                    myInt: Integer;
                    TTops: Record "Loans Top up";
                begin
                    TTops.Reset;
                    TTops.SetRange(TTops."Loan Top Up", "Loans Top up"."Loan Top Up");
                    if TTops.Find('-') then begin
                        IntCom := 0;
                        PCharges.Reset;
                        PCharges.SetRange(PCharges."Product Code", TTops."Loan Type");
                        PCharges.SetRange(PCharges."Charge Type", PCharges."charge type"::"Top up");
                        if PCharges.Find('-') then begin
                            repeat
                                if PCharges."Charge Method" = PCharges."Charge Method"::"Flat Amount" then
                                    IntCom := PCharges."Charge Amount"
                                else
                                    if (PCharges."Charge Method" = PCharges."charge method"::"% of Amount") and (PCharges."Charging Option" = PCharges."charging option"::"On Approved Amount") then begin
                                        if PCharges."Use Percentage" = true then
                                            IntCom := (TTops."Outstanding Balance" * (PCharges.Percentage + PCharges."Additional Charge %") / 100)
                                        else
                                            IntCom := (TTops."Outstanding Balance" * (PCharges.Percentage / 100));
                                    end else
                                        if (PCharges."Charge Method" = PCharges."charge method"::"% of Amount") and (PCharges."Charging Option" = PCharges."charging option"::"On Net Amount") then begin
                                            if PCharges."Use Percentage" = true then
                                                IntCom := ((TTops."Outstanding Balance") * (PCharges.Percentage + PCharges."Additional Charge %") / 100)
                                            else
                                                IntCom := ((TTops."Outstanding Balance") * (PCharges.Percentage / 100))
                                        end else
                                            IntCom := PCharges."Charge Amount";
                            until PCharges.Next = 0;

                            //getexcise duty
                            if PCharges."Effect Excise Duty" = PCharges."effect excise duty"::Yes then begin
                                GenSetup.Get();//TESTFIELD("Excise Duty G/L");
                                IntComExcise := IntCom * GenSetup."Excise Duty (%)" * 0.01;
                            end;
                        end;
                        Twothird := true;
                    end;


                end;

            }
