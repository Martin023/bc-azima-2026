                      <FontFamily>Yu Gothic UI Semilight</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> in Mwalimu Savings and Credit Society Co-operative </Value>
                    <Style>
                      <FontFamily>Yu Gothic UI Semilight</FontFamily>
                      <FontSize>12pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Society Ltd, on the </Value>
                    <Style>
