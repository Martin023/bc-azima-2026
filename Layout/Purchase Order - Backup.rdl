              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>        C.E.O...................................................................Signed....................................................Date........................................</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                    </Style>
                  </TextRun>
