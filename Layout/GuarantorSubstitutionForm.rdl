                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="Page1FormRect">
                          <ReportItems>
                            <Textbox Name="FormTitle">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>SUBSTITUTE GUARANTEE FORM</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>14pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <TextDecoration>Underline</TextDecoration>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>(TO BE COMPLETED BY THE NEW GUARANTOR IN DUPLICATE)</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Top>0.2in</Top>
                              <Left>0in</Left>
                              <Height>0.6in</Height>
                              <Width>7.5in</Width>
                              <Style />
                            </Textbox>
                            <Textbox Name="FormBodyText">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>I ____________________________________________D/NO. ___________________W/NO. _________________              in Consideration of the outstanding loan balance of (Name) </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!LoaneeName.Value</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> W/NO. </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!LoaneeWNo.Value</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> as at </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!ReportDate.Value</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value />
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>amounting to Kshs </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Format(Fields!OutstandingBal.Value, "#,0.00")</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> do hereby accept jointly and severally the liability for its</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value />
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>payment in the events of the borrower's default in Substitution of </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!OutG_Name.Value</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> W/NO </Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Fields!OutG_No.Value</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>. I understand that the</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value />
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>amount in default may be recovered by an offset against my shares in the Society or an attachment of my property or salary and that I shall not be eligible for loans unless the amount in default has been cleared in full.</Value>
                                      <Style>
                                        <FontFamily>Calibri</FontFamily>
                                        <FontSize>11pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
