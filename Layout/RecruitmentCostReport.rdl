                                  <Height>1.2cm</Height>
                                  <Width>10cm</Width>
                                  <Style />
                                </Textbox>
                                <Textbox Name="ReqInfoRight">
                                  <CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph>
                                      <TextRuns>
                                        <TextRun>
                                          <Value>="Status: " &amp; Fields!Approval_Status.Value &amp; vbCrLf &amp; "Req Date: " &amp; Fields!Requisition_Date.Value</Value>
