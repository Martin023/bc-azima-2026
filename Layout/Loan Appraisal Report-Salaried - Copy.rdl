          <Textbox Name="Textbox126">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Take Home Amount     : </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!NetTakeHome.Value, "DataSet_Result")</Value>
                    <Style>
