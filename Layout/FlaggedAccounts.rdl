<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="Tablix1">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>1.0in</Width></TablixColumn>
                <TablixColumn><Width>1.5in</Width></TablixColumn>
                <TablixColumn><Width>0.8in</Width></TablixColumn>
                <TablixColumn><Width>0.9in</Width></TablixColumn>
                <TablixColumn><Width>3.5in</Width></TablixColumn>
                <TablixColumn><Width>0.9in</Width></TablixColumn>
                <TablixColumn><Width>0.8in</Width></TablixColumn>
                <TablixColumn><Width>0.5in</Width></TablixColumn>
                <TablixColumn><Width>0.8in</Width></TablixColumn>
                <TablixColumn><Width>0.5in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                
                <!-- HEADER ROW -->
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="H_Acc"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Member No.</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Name"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Member Name</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_ID"><Paragraphs><Paragraph><TextRuns><TextRun><Value>ID Number</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Phone"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Phone No.</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Reason"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Flag Reason / Comment</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_By"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Flagged By</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Date"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Flag Date</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Days"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Days</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Status"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="H_Branch"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Branch</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#004080</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                
                <!-- GROUP HEADER ROW -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="GH_L1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Branch: "</Value><Style><FontWeight>Bold</FontWeight><Color>#004080</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_V1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Fields!Branch.Value &lt;&gt; "", Fields!Branch.Value, "MAIN")</Value><Style><FontWeight>Bold</FontWeight><Color>#004080</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E3"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E4"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E5"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E6"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E7"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E8"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E9"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GH_E10"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>LightSteelBlue</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- DETAIL ROW -->
                <TablixRow>
                  <Height>0.35in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="MemberAccountNo"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!MemberAccountNo.Value</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="FullMemberName"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Fields!FullMemberName.Value &lt;&gt; "", Fields!FullMemberName.Value, Fields!MemberName.Value)</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="IDNumber"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!IDNumber.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="PhoneNumber"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PhoneNumber.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="FlagReason"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FlagReason.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="FlaggedBy"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FlaggedBy.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="FlagDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!FlagDate.Value, "dd-MMM-yyyy")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DaysSinceFlagged"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DaysSinceFlagged.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="FlagStatus"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!FlagStatus.Value</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>=IIf(Fields!FlagStatus.Value="Expired", "Red", "Green")</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="Branch"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Branch.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><BackgroundColor>=IIf(RowNumber("BranchGroup") Mod 2 = 0, "#F2F2F2", "Transparent")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- GROUP FOOTER ROW -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="GF_E1"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E2"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E3"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E4"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_L5"><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Total Flagged in Branch:"</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><PaddingTop>2pt</PaddingTop><TextAlign>Right</TextAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_V6"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows("BranchGroup")</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border><PaddingTop>2pt</PaddingTop><PaddingLeft>2pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E7"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E8"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E9"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GF_E10"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Color>LightGrey</Color></Border></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember>
                  <Visibility><Hidden>=IIf(First(Fields!ShowMemberDetails.Value, "DataSet_Result"), False, True)</Hidden></Visibility>
                </TablixMember>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember>
                  <Visibility><Hidden>=IIf(First(Fields!ShowMemberDetails.Value, "DataSet_Result"), False, True)</Hidden></Visibility>
                </TablixMember>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
                <TablixMember>
                  <Group Name="BranchGroup">
                    <GroupExpressions><GroupExpression>=IIf(Fields!GroupByBranch.Value, Fields!Branch.Value, 1)</GroupExpression></GroupExpressions>
                  </Group>
                  <TablixMembers>
                    <TablixMember>
                      <Visibility><Hidden>=IIf(Fields!GroupByBranch.Value, False, True)</Hidden></Visibility>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>
                    <TablixMember><Group Name="Details" /></TablixMember>
                    <TablixMember>
                      <Visibility><Hidden>=IIf(Fields!GroupByBranch.Value, False, True)</Hidden></Visibility>
                      <KeepWithGroup>Before</KeepWithGroup>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>DataSet_Result</DataSetName>
            <Top>0.1in</Top>
            <Left>0in</Left>
            <Height>1.15in</Height>
            <Width>11.2in</Width>
          </Tablix>
        </ReportItems>
        <Height>1.5in</Height>
        <Style />
      </Body>
      <Width>11.2in</Width>
      <Page>
        <PageHeader>
          <Height>1.3in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <!-- REPLACED: Updated field names to match Original AL -->
            <Image Name="CompanyLogo">
              <Source>Database</Source>
              <Value>=First(Fields!CompanyInformation_Picture.Value, "DataSet_Result")</Value>
              <MIMEType>image/png</MIMEType>
              <Sizing>FitProportional</Sizing>
              <Top>0.1in</Top>
              <Left>0.1in</Left>
              <Height>0.9in</Height>
              <Width>1.8in</Width>
            </Image>
            <Textbox Name="CompanyName">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyInformation_Name.Value, "DataSet_Result")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#004080</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Center</TextAlign></Style>
              <Top>0.1in</Top><Left>2.0in</Left><Height>0.3in</Height><Width>7.2in</Width>
            </Textbox>
            <Textbox Name="ReportTitle">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>FLAGGED ACCOUNTS REPORT</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>Underline</TextDecoration></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Center</TextAlign></Style>
              <Top>0.4in</Top><Left>2.0in</Left><Height>0.25in</Height><Width>7.2in</Width>
            </Textbox>
            <Textbox Name="CompanyAddress">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyAddress.Value, "DataSet_Result")</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Center</TextAlign></Style>
              <Top>0.65in</Top><Left>2.0in</Left><Height>0.2in</Height><Width>7.2in</Width>
            </Textbox>
            <Textbox Name="CompanyContact">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyTelephone.Value, "DataSet_Result") &amp; " | " &amp; First(Fields!CommunicationOnline.Value, "DataSet_Result")</Value><Style><FontSize>8pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Center</TextAlign></Style>
              <Top>0.85in</Top><Left>2.0in</Left><Height>0.2in</Height><Width>7.2in</Width>
            </Textbox>
            <Textbox Name="PrintDate">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>="Printed: " &amp; Format(Globals!ExecutionTime, "dd-MMM-yyyy hh:mm tt")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Right</TextAlign></Style>
              <Top>1.0in</Top><Left>9.2in</Left><Height>0.2in</Height><Width>2.0in</Width>
            </Textbox>
          </ReportItems>
        </PageHeader>
        <PageFooter>
          <Height>0.4in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="TotalCount">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>="Total Flagged Accounts: " &amp; CountRows("DataSet_Result")</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Top>0.1in</Top><Left>0.1in</Left><Height>0.2in</Height><Width>3.0in</Width>
            </Textbox>
            <Textbox Name="PrintedBy">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>="Generated By: " &amp; User!UserID</Value><Style><FontSize>9pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Center</TextAlign></Style>
              <Top>0.1in</Top><Left>4.1in</Left><Height>0.2in</Height><Width>3.0in</Width>
            </Textbox>
            <Textbox Name="PageNumber">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
              <Style><TextAlign>Right</TextAlign></Style>
              <Top>0.1in</Top><Left>9.2in</Left><Height>0.2in</Height><Width>2.0in</Width>
            </Textbox>
          </ReportItems>
        </PageFooter>
        <PageHeight>8.27in</PageHeight>
        <PageWidth>11.69in</PageWidth>
        <LeftMargin>0.2in</LeftMargin>
        <RightMargin>0.2in</RightMargin>
        <TopMargin>0.25in</TopMargin>
        <BottomMargin>0.25in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <Language>=User!Language</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <DataSets>
    <DataSet Name="DataSet_Result">
      <Fields>
        <!-- REPLACED: Updated exact field names here as well -->
        <Field Name="EntryNo"><DataField>EntryNo</DataField></Field>
        <Field Name="MemberAccountNo"><DataField>MemberAccountNo</DataField></Field>
        <Field Name="FlagReason"><DataField>FlagReason</DataField></Field>
        <Field Name="FlaggedBy"><DataField>FlaggedBy</DataField></Field>
        <Field Name="FlagDate"><DataField>FlagDate</DataField></Field>
        <Field Name="ExpiresAt"><DataField>ExpiresAt</DataField></Field>
        <Field Name="Branch"><DataField>Branch</DataField></Field>
        <Field Name="Department"><DataField>Department</DataField></Field>
        <Field Name="ResponsibilityCenter"><DataField>ResponsibilityCenter</DataField></Field>
        <Field Name="DaysSinceFlagged"><DataField>DaysSinceFlagged</DataField></Field>
