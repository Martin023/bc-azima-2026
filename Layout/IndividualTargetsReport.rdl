  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="MasterList">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>19cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>3.5cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="ListRectangle">
                          <ReportItems>
                            <Rectangle Name="DocHeaderRect">
                              <ReportItems>
                                <Textbox Name="EmployeeInfo">
                                  <CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph>
                                      <TextRuns>
                                        <TextRun>
                                          <Value>="Appraisal No: " &amp; Fields!Appraisal_No.Value &amp; vbCrLf &amp; "Employee: " &amp; Fields!Employee_Name.Value &amp; " (" &amp; Fields!Employee_No.Value &amp; ")" &amp; vbCrLf &amp; "Department: " &amp; Fields!Department_Name.Value</Value>
                                          <Style>
                                            <FontFamily>Segoe UI</FontFamily>
                                            <FontSize>9pt</FontSize>
                                            <FontWeight>Bold</FontWeight>
                                          </Style>
                                        </TextRun>
                                      </TextRuns>
                                      <Style />
                                    </Paragraph>
                                  </Paragraphs>
                                  <Top>0.2cm</Top>
                                  <Left>0.2cm</Left>
                                  <Height>1.5cm</Height>
                                  <Width>9cm</Width>
                                  <Style />
                                </Textbox>
                                <Textbox Name="StatusAndScoresInfo">
                                  <CanGrow>true</CanGrow>
                                  <Paragraphs>
                                    <Paragraph>
                                      <TextRuns>
                                        <TextRun>
                                          <Value>="Year/Period: " &amp; Fields!Appraisal_Year.Value &amp; " " &amp; Fields!Appraisal_Period.Value &amp; " | Status: " &amp; Fields!Status.Value &amp; vbCrLf &amp; "Supervisor: " &amp; Fields!Supervisor_Name.Value &amp; vbCrLf &amp; "Target Score: " &amp; Fields!Total_Targeted_Score.Value &amp; " | Achieved: " &amp; Fields!Total_Achieved_Score.Value</Value>
                                          <Style>
                                            <FontFamily>Segoe UI</FontFamily>
                                            <FontSize>9pt</FontSize>
                                          </Style>
                                        </TextRun>
                                      </TextRuns>
                                      <Style />
                                    </Paragraph>
                                  </Paragraphs>
                                  <Top>0.2cm</Top>
                                  <Left>9.5cm</Left>
                                  <Height>1.5cm</Height>
                                  <Width>9.3cm</Width>
                                  <ZIndex>1</ZIndex>
                                  <Style />
                                </Textbox>
                              </ReportItems>
                              <Height>1.8cm</Height>
                              <Width>19cm</Width>
                              <Style>
                                <Border>
                                  <Color>LightGrey</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#f9f9f9</BackgroundColor>
