  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- HEADER AND DATE -->
          <Textbox Name="CompanyNameTextBox">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!CompanyName.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontSize>11pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!CompanyAddress.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.5cm</Top>
            <Left>0.5cm</Left>
            <Height>1.2cm</Height>
            <Width>19.0cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
            </Style>
          </Textbox>
          <Textbox Name="PrintDateTextBox">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Print Date     </Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Format(First(Fields!PrintDateTime.Value, "DataSet_Result"), "dd/MM/yyyy")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>2.0cm</Top>
            <Left>0.5cm</Left>
            <Height>0.6cm</Height>
            <Width>6.5cm</Width>
            <ZIndex>1</ZIndex>
            <Style>
