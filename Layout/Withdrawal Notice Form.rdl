                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.6in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="SalutationBox">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>The C.E.O,
Azima SACCO Society Limited
Dear Sir/Madam,</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>5pt</PaddingTop>
                            <PaddingBottom>5pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TitleBox">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>RE: NOTICE OF WITHDRAWAL FROM THE SOCIETY.</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>12pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>5pt</PaddingTop>
                            <PaddingBottom>5pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.5in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BodyBox1">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>I wish to withdraw my membership with Azima Savings and Credit Co-operative Society Limited </Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>on expiry of 60 days from the date of this notice.</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> I therefore, kindly request the Society to stop my monthly contributions effective this month of...........................................................................</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>5pt</PaddingTop>
                            <PaddingBottom>5pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>1.1in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ReasonBox">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>REASON FOR WITHDRAWAL.........................................................................................................................................
....................................................................................................................................................................................
WHEN TO REJOIN: .......................................................................................................................................................
SIGNED BY:..................................................................DATE..........................................................................................
APPROVED BY ANY OFFICIAL: ....................................................................................................................................</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>10pt</PaddingTop>
                            <PaddingBottom>10pt</PaddingBottom>
                            <LineHeight>16pt</LineHeight>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="OfficialUseTitle">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>FOR OFFICIAL USE ONLY: -</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>12pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>5pt</PaddingTop>
                            <PaddingBottom>5pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>2.6in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="OfficialUseLines">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Deposits: " &amp; Format(Fields!TotalDeposits.Value, "N2") &amp; vbCrLf &amp;
"Outstanding Normal / Jijenge / Jipange Loan: " &amp; Format(Fields!NormJijJipPrin.Value, "N2") &amp; vbCrLf &amp;
"Interest on Normal / Jijenge / Jipange Loan: " &amp; Format(Fields!NormJijJipInt.Value, "N2") &amp; vbCrLf &amp;
"Short Term Loans (SL &amp; EL): " &amp; Format(Fields!ShortTermPrinInt.Value, "N2") &amp; vbCrLf &amp;
"Masomo Loan + interest: " &amp; Format(Fields!MasomoPrinInt.Value, "N2") &amp; vbCrLf &amp;
"Defaulters loan + Interest: " &amp; Format(Fields!DefaulterPrinInt.Value, "N2") &amp; vbCrLf &amp;
"Pineapple Loan + interest: " &amp; Format(Fields!PineapplePrinInt.Value, "N2") &amp; vbCrLf &amp;
"Super loan + interest: " &amp; Format(Fields!SuperPrinInt.Value, "N2") &amp; vbCrLf &amp;
"Salary Advance / Okoa Mwezi / Azima+ Interest: " &amp; Format(Fields!SalAdvOkoaPrinInt.Value, "N2") &amp; vbCrLf &amp;
"Share Capital: " &amp; Format(Fields!ShareCapital.Value, "N2") &amp; vbCrLf &amp;
"Withdrawal Charges: " &amp; Format(Fields!WithdrawalCharges.Value, "N2") &amp; vbCrLf &amp;
"Instant refund charges (10% of remaining deposit): " &amp; Format(Fields!InstantRefundCharge.Value, "N2") &amp; vbCrLf &amp;
"Amount to be refunded: " &amp; Format(Fields!AmountToBeRefunded.Value, "N2")</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <LineHeight>16pt</LineHeight>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingTop>5pt</PaddingTop>
                            <PaddingBottom>10pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>1in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="RecommendationsBox">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Loans Office: (Recommendations):-         </Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>Notice Accepted. [_]                  Deferred [_]</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>(Until he/she provides alternative guarantor(s) as shown above :)</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value />
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Worked out by: </Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>Loan Officer.............................................Signature.....................................Date................................</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Verified by: </Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>       Credit/Branch Manager............................Signature.....................................Date................................</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Authorized by: </Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>    Finance Manager/CEO...............................Signature.....................................Date.............................</Value>
                                  <Style>
