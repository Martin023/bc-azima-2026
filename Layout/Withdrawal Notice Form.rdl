      <Width>7.5in</Width>
      <Page>
        <PageHeader>
          <Height>1.2in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Image Name="CompanyLogoHeader">
              <Source>Database</Source>
              <Value>=First(Fields!CompanyInfo_Picture.Value, "DataSet_Result")</Value>
              <MIMEType>image/jpeg</MIMEType>
              <Sizing>FitProportional</Sizing>
              <Top>0in</Top>
              <Left>0in</Left>
              <Height>1in</Height>
              <Width>1.6in</Width>
              <Style />
            </Image>
            <Textbox Name="CompanyDetailsHeader">
              <CanGrow>true</CanGrow>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=First(Fields!CompanyInfo_Name.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=First(Fields!CompanyInfo_Address.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <Top>0in</Top>
              <Left>1.7in</Left>
              <Height>0.4in</Height>
              <Width>3in</Width>
              <ZIndex>1</ZIndex>
              <Style />
            </Textbox>
            <Textbox Name="CompanyContactsHeader">
              <CanGrow>true</CanGrow>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=First(Fields!CompanyTelephone.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=First(Fields!CompanyEmail.Value, "DataSet_Result") &amp; ", " &amp; First(Fields!CompanyWebsite.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
                        <FontSize>9pt</FontSize>
                        <TextDecoration>Underline</TextDecoration>
                        <Color>Blue</Color>
                      </Style>
