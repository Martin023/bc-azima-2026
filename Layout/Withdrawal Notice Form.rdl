                    <TablixCell>
                      <CellContents>
                        <Textbox Name="MemberDetailsBox">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>NAME: </Value>
