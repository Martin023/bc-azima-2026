        <Field Name="ReprintDate">
          <DataField>ReprintDate</DataField>
        </Field>
        <Field Name="ReprintTime">
          <DataField>ReprintTime</DataField>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText />
      </Query>
    </DataSet>
