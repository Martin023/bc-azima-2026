                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Tel: " &amp; First(Fields!CompanyInfo_Phone.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Right</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Email: " &amp; First(Fields!CompanyInfo_Email.Value, "DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Right</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0.8cm</Top>
              <Left>8cm</Left>
              <Height>1.5cm</Height>
              <Width>11.5cm</Width>
              <ZIndex>1</ZIndex>
              <Style />
            </Textbox>
            <Textbox Name="ReportTitle">
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>PERSPECTIVE ANALYSIS REPORT</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>14pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <TextDecoration>Underline</TextDecoration>
                        <Color>#333333</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Center</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>2.6cm</Top>
              <Height>0.8cm</Height>
              <Width>19.5cm</Width>
              <ZIndex>2</ZIndex>
              <Style />
            </Textbox>
            <Image Name="CompanyLogo">
              <Source>Database</Source>
              <Value>=First(Fields!CompanyInfo_Picture.Value, "DataSet_Result")</Value>
              <MIMEType>image/png</MIMEType>
              <Sizing>FitProportional</Sizing>
              <Top>0.2cm</Top>
              <Height>3.2cm</Height>
              <Width>6cm</Width>
              <ZIndex>3</ZIndex>
              <Style />
            </Image>
          </ReportItems>
