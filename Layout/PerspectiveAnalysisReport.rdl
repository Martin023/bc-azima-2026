                      <CellContents>
                        <Textbox Name="Target_Achievement_Percentage">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Target_Achievement_Percentage.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>#,0.00' %'</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
