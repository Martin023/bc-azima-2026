          <Textbox Name="Textbox60">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>PLEASE NOTE:</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Your </Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!ProcessingYear.Value</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontSize>8pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>dividends and interest rebates were based on weighted average deposits and shares and not their respective totals as at </Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!EndDate.Value</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Format>dd/MM/yyyy</Format>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>.</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>WE ENCOURAGE YOU TO RE-INVEST YOUR DIVIDENDS FOR BETTER RETURNS IN FUTURE PLEASE NOTIFY THE UNDERSIGNED OF ANY DISCREPANCIES ON THIS ADVICE SLIP.</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>THANK YOU FOR YOUR CONTINUED SUPPORT</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>CHIEF EXECUTIVE OFFICER</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
