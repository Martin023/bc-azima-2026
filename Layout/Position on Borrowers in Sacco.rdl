                      <CellContents>
                        <Textbox Name="Textbox36">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>The Authority is hereby notified Pursuant to</Value>
                                  <Style>
                                    <FontFamily>Times New Roman</FontFamily>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value xml:space="preserve"> </Value>
                                  <Style>
                                    <FontFamily>Times New Roman</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>Reg.36 of the sacco societies (DTSB) Regulations, 2010 </Value>
                                  <Style>
                                    <FontStyle>Italic</FontStyle>
                                    <FontFamily>Times New Roman</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>that the above named officer of the sacco was granted the following credit facility.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontFamily>Times New Roman</FontFamily>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
