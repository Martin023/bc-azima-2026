                  <TextRun>
                    <Value>                    MUTUAL NON-DISCLOSURE AND CONFIDENTIALITY AGREEMENT 
</Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>

THIS AGREEMENT is made on </Value>
                    <Style>
                      <FontFamily>Book Antiqua</FontFamily>
                      <FontSize>12pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Label>Date of Execution</Label>
