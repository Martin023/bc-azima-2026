                  <TextRun>
                    <Value> and whose ID No. is  </Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Label>ID No.</Label>
                    <Value>=First(Fields!PrimaryIdentification.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> is the register holder of (Total Number of shares) of Kshs 20/- each amounting to Kshsh (Total Share Capital Value) in Mwalimu National Savings and Credit Co-operative Society Ltd, on this (date)</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
